# CHRIS — public deployment environment.
#
# Copy to `.env.local` (local dev) or set these in the Vercel project dashboard
# (Production + Preview). The client bundle NEVER receives these values — only the
# serverless /api/narrate function reads them.

# ── Narration source for /api/narrate ────────────────────────────────────────
# Choose ONE. If neither is set, narration fails closed (deterministic fallback
# lines) and the game is still fully playable.

# Option A — HOSTED model (recommended for public, decision #1). OpenAI-compatible
# chat/completions endpoint. The key stays server-side only.
# CHRIS_HOSTED_URL=https://api.openai.com/v1
# CHRIS_HOSTED_KEY=sk-...
# CHRIS_HOSTED_MODEL=gpt-4o-mini

# Option B — LOCAL model (dev/contributor only). Only add these on a machine that
# actually runs llama.cpp / ollama. Never set in a public deploy.
# CHRIS_LLAMACPP_URL=http://127.0.0.1:8080
# CHRIS_LLAMACPP_MODEL=ornith.gguf
# CHRIS_OLLAMA_URL=http://127.0.0.1:11434
# CHRIS_OLLAMA_MODEL=ornith.gguf

# ── Client flags (inlined at build, NOT secrets) ──────────────────────────────
# Public narration path: client POSTs to /api/narrate (default "hosted").
# "off" / "deterministic" skips even the request and uses local fallback lines.
NEXT_PUBLIC_NARRATION=hosted

# Cloned-voice TTS (vox, Qwen3-TTS). OFF for public (decision #4). Set to "1"
# ONLY in local/dev builds. When unset, the voice toggle is hidden and /api/tts
# returns 503.
NEXT_PUBLIC_TTS_ENABLED=0

# ── Dev-only toggles ──────────────────────────────────────────────────────────
# Use the LLM as the intent resolver (needs a local model). Off for public.
# CHRIS_USE_LLM_PARSE=0
# Allow a mock fallback if all providers are down (NEVER set in production).
# CHRIS_ALLOW_MOCK_FALLBACK=0
